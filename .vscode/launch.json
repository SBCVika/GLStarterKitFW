{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32F407",
      "type": "mcu-debug",
      "request": "launch",
      "servertype": "openocd",
      "executable": "${workspaceFolder}/build/debug/embedded_workshop.elf",
      "svdFile": "${workspaceFolder}/third_party/svd/STM32F407.svd",
      "configFiles": [
        "interface/stlink-v2.cfg",
        "target/stm32f4x.cfg"
      ],
      "serverArgs": ["-c", "adapter speed 1800"],
      "runToEntryPoint": "main"
    },
    {
      "name": "Debug STM32F407 (FreeRTOS Tasks)",
      "type": "mcu-debug",
      "request": "launch",
      "servertype": "openocd",
      "executable": "${workspaceFolder}/build/debug/embedded_workshop.elf",
      "svdFile": "${workspaceFolder}/third_party/svd/STM32F407.svd",
      "configFiles": [
        "interface/stlink-v2.cfg",
        "target/stm32f4x.cfg"
      ],
      "serverArgs": ["-c", "adapter speed 1800"],
      "runToEntryPoint": "main",
      "rtos": "FreeRTOS"
    }
  ]
}
